# The dock of a bot's 1280x800 apps display: launchers, open apps and a clock, in a translucent rounded bar at the
# bottom center. It looks through to the wallpaper by the root pixmap that hsetroot publishes (_XROOTPMAP_ID).

# Backgrounds. The first block starts the first one: 1 is the dock, 2 an app tile (lit when hovered or pressed),
# 3 the tile of the active app, 4 a tooltip.
rounded = 18
border_width = 1
border_sides = TBLR
border_content_tint_weight = 0
background_content_tint_weight = 0
background_color = #ffffff 28
border_color = #ffffff 50
background_color_hover = #ffffff 28
border_color_hover = #ffffff 50
background_color_pressed = #ffffff 28
border_color_pressed = #ffffff 50

rounded = 14
border_width = 0
border_sides = TBLR
border_content_tint_weight = 0
background_content_tint_weight = 0
background_color = #ffffff 0
border_color = #ffffff 0
background_color_hover = #ffffff 34
border_color_hover = #ffffff 0
background_color_pressed = #ffffff 52
border_color_pressed = #ffffff 0

rounded = 14
border_width = 0
border_sides = TBLR
border_content_tint_weight = 0
background_content_tint_weight = 0
background_color = #ffffff 42
border_color = #ffffff 0
background_color_hover = #ffffff 52
border_color_hover = #ffffff 0
background_color_pressed = #ffffff 62
border_color_pressed = #ffffff 0

rounded = 8
border_width = 0
border_sides = TBLR
border_content_tint_weight = 0
background_content_tint_weight = 0
background_color = #14121a 92
border_color = #14121a 0
background_color_hover = #14121a 92
border_color_hover = #14121a 0
background_color_pressed = #14121a 92
border_color_pressed = #14121a 0

# Panel: shrinks to its content and floats 10 px above the bottom edge, in the middle.
panel_items = LTC
panel_size = 100% 66
panel_position = bottom center horizontal
panel_margin = 0 10
panel_padding = 10 8 6
panel_background_id = 1
panel_shrink = 1
panel_layer = top
panel_monitor = all
panel_dock = 0
wm_menu = 0
strut_policy = follow_size
autohide = 0
disable_transparency = 0
font_shadow = 0
mouse_effects = 1
mouse_hover_icon_asb = 100 0 8
mouse_pressed_icon_asb = 100 0 -6

# Launchers, in this order. The apps are Maestrly's own launchers: browser, terminal and files.
launcher_padding = 0 0 8
launcher_background_id = 0
launcher_icon_background_id = 2
launcher_icon_size = 44
launcher_icon_asb = 100 0 0
launcher_tooltip = 1
launcher_item_app = /usr/share/applications/maestrly-browser.desktop
launcher_item_app = /usr/share/applications/maestrly-terminal.desktop
launcher_item_app = /usr/share/applications/maestrly-files.desktop

# Open apps: an icon each, with a tip for the title.
taskbar_mode = single_desktop
taskbar_padding = 0 0 8
taskbar_background_id = 0
taskbar_name = 0
task_text = 0
task_icon = 1
task_centered = 1
task_tooltip = 1
task_maximum_size = 52 52
task_padding = 4 4 0
task_background_id = 2
task_active_background_id = 3
task_urgent_background_id = 3
task_iconified_background_id = 2
task_icon_asb = 100 0 0
task_active_icon_asb = 100 0 0
task_iconified_icon_asb = 75 0 0
task_urgent_icon_asb = 100 0 0

# Clock
time1_format = %H:%M
time1_font = DejaVu Sans Bold 12
time2_format =
clock_font_color = #1c1a26 90
clock_padding = 12 0
clock_background_id = 0
clock_tooltip = %A, %d/%m/%Y
clock_lclick_command =
clock_rclick_command =

# Tooltips
tooltip_show_timeout = 0.3
tooltip_hide_timeout = 0.1
tooltip_padding = 10 6
tooltip_background_id = 4
tooltip_font_color = #ffffff 100
tooltip_font = DejaVu Sans 10

# Mouse: a click on an open app shows or hides it; nothing else is bound.
mouse_left = toggle_iconify
mouse_middle = none
mouse_right = none
mouse_scroll_up = none
mouse_scroll_down = none
