{
  "name": "maestrly-app",
  "version": "0.2.0",
  "description": "A local AI workspace with chat, Maestro orchestration, and developer tools",
  "author": "Maestrly contributors",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "clean:dev": "node scripts/clean-dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "npm run test:unit && npm run test:policy && npm run test:docs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "build:local-ml-runtime": "node scripts/build-local-ml-runtime.mjs",
    "smoke:local-ml-runtime": "node scripts/smoke-local-ml-runtime.mjs",
    "verify:cross-local-ml-runtime": "node scripts/verify-cross-local-ml-runtime.mjs",
    "smoke:packaged-local-ml-runtime": "node scripts/smoke-packaged-local-ml-runtime.mjs",
    "size:report": "node scripts/report-bundle-size.mjs dist --json=dist/bundle-size-report.json",
    "size:check": "node scripts/check-bundle-size.mjs --report=dist/bundle-size-report.json",
    "size:baseline": "node scripts/check-bundle-size.mjs --report=dist/bundle-size-report.json --update-baseline",
    "audit:dependencies": "node scripts/audit-dependencies.mjs && npm audit --omit=dev --prefix runtime-assets/local-ml",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/postinstall.mjs",
    "rebuild": "electron-rebuild -f -w node-pty",
    "icon": "node scripts/convert-icon.mjs",
    "icon:beta": "node scripts/convert-icon.mjs beta",
    "icon:dev": "node scripts/convert-icon.mjs dev",
    "package": "node scripts/package.mjs prod --mac --arm64",
    "package:beta": "node scripts/package.mjs beta --mac --arm64 --config electron-builder.beta.yml",
    "package:release": "node scripts/preflight-mac-signing.mjs && node scripts/package.mjs prod --mac dmg zip --arm64 --config electron-builder.release.yml",
    "package:release:beta": "node scripts/preflight-mac-signing.mjs && node scripts/package.mjs beta --mac dmg zip --arm64 --config electron-builder.release.beta.yml",
    "package:win": "node scripts/package.mjs prod --win --x64",
    "package:win:arm64": "node scripts/package.mjs prod --win --arm64",
    "package:beta:win": "node scripts/package.mjs beta --win --x64 --config electron-builder.beta.yml",
    "package:beta:win:arm64": "node scripts/package.mjs beta --win --arm64 --config electron-builder.beta.yml",
    "package:linux": "node scripts/package.mjs prod --linux --x64",
    "package:linux:arm64": "node scripts/package.mjs prod --linux --arm64",
    "package:beta:linux": "node scripts/package.mjs beta --linux --x64 --config electron-builder.beta.yml",
    "package:beta:linux:arm64": "node scripts/package.mjs beta --linux --arm64 --config electron-builder.beta.yml",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "check:history": "node scripts/check-commits.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:policy": "node --test tests/policy/*.test.mjs",
    "test:docs": "node scripts/check-markdown-links.mjs",
    "models:prepare": "node scripts/prepare-local-ml-models.mjs",
    "smoke:packaged-desktop": "node scripts/smoke-packaged-desktop.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/openai": "^4.0.58",
    "@ai-sdk/openai-compatible": "^3.0.43",
    "@ai-sdk/provider": "^4.0.10",
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@github/copilot": "1.0.71",
    "@github/copilot-sdk": "1.0.7",
    "@milkdown/crepe": "^7.22.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@tailwindcss/vite": "^4.3.3",
    "@xterm/headless": "^6.0.0",
    "ai": "^7.0.92",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.41.0",
    "mermaid": "^11.15.0",
    "node-pty": "1.1.0",
    "parse5": "8.0.1",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tar-stream": "3.2.0",
    "tw-animate-css": "^1.4.0",
    "yauzl": "^3.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@electron/asar": "4.3.0",
    "@electron/rebuild": "4.2.0",
    "@openai/codex": "0.153.4",
    "@playwright/test": "^1.62.1",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/tar-stream": "^3.1.4",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "7zip-bin": "5.2.0",
    "app-builder-bin": "^4.2.0",
    "electron": "42.11.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonioducs/maestrly-app.git"
  },
  "engines": {
    "node": ">=22.15.0 <23",
    "npm": ">=10"
  }
}
