{
  "name": "maestrly",
  "version": "0.17.0",
  "description": "A local-first AI workspace with chat, Maestro orchestration, and developer tools",
  "author": "Maestrly contributors",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:desktop",
    "dev:desktop": "npm run build:protocol && npm run build:fleet-protocol && npm run build:artifact-host && npm run dev --workspace @maestrly/desktop",
    "dev:bot-gateway": "npm run build:fleet-protocol && npm run build:artifact-host && npm run dev --workspace @maestrly/bot-gateway",
    "build": "npm run build:desktop",
    "build:desktop": "npm run build:protocol && npm run build:fleet-protocol && npm run build:artifact-host && npm run build --workspace @maestrly/desktop",
    "build:fleet-protocol": "npm run build --workspace @maestrly/bot-fleet-protocol",
    "build:artifact-host": "npm run build --workspace @maestrly/artifact-host",
    "build:bot-gateway": "npm run build:fleet-protocol && npm run build:artifact-host && npm run build --workspace @maestrly/bot-gateway",
    "build:protocol": "npm run build --workspace @maestrly/protocol",
    "check:desktop": "npm run build:protocol && npm run build:fleet-protocol && npm run build:artifact-host && npm run check --workspace @maestrly/desktop",
    "check:fleet-protocol": "npm run check --workspace @maestrly/bot-fleet-protocol",
    "check:artifact-host": "npm run check --workspace @maestrly/artifact-host",
    "check:bot-gateway": "npm run build:fleet-protocol && npm run build:artifact-host && npm run check --workspace @maestrly/bot-gateway",
    "check:protocol": "npm run check --workspace @maestrly/protocol",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:local-ml-toolchain": "node scripts/local-ml-toolchain.mjs",
    "check": "npm run check:boundaries && npm run check:protocol && npm run check:fleet-protocol && npm run check:artifact-host && npm run check:bot-gateway && npm run check:desktop",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "test": "npm run test:unit && npm run test:policy && npm run test:docs",
    "test:unit": "npm run test:unit --workspace @maestrly/desktop",
    "test:policy": "node --test tests/policy/*.test.mjs",
    "test:docs": "node scripts/check-markdown-links.mjs",
    "test:e2e": "npm run test:e2e --workspace @maestrly/desktop",
    "test:e2e:docker": "node scripts/test-e2e-docker.mjs",
    "package": "npm run package --workspace @maestrly/desktop",
    "package:linux": "npm run package:linux --workspace @maestrly/desktop",
    "package:win": "npm run package:win --workspace @maestrly/desktop",
    "package:release": "npm run package:release --workspace @maestrly/desktop",
    "smoke:packaged-desktop": "npm run smoke:packaged-desktop --workspace @maestrly/desktop",
    "smoke:packaged-local-ml-runtime": "npm run smoke:packaged-local-ml-runtime --workspace @maestrly/desktop",
    "postinstall": "node scripts/postinstall.mjs",
    "audit:dependencies": "node scripts/audit-dependencies.mjs && npm audit --omit=dev --prefix apps/desktop/runtime-assets/local-ml",
    "check:history": "node scripts/check-commits.mjs",
    "verify:pr": "node scripts/verify-pr.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "smoke:packaged-cursor-sdk": "node scripts/smoke-packaged-cursor-sdk.mjs",
    "smoke:cursor-sdk-authenticated": "node scripts/smoke-cursor-sdk-authenticated.mjs",
    "verify:packaged-cursor-sdk": "node scripts/verify-packaged-cursor-sdk.mjs",
    "test:e2e:bot-fleet": "npm run build --workspace @maestrly/bot-fleet-protocol && node scripts/test-bot-fleet-e2e.mjs",
    "test:e2e:bot-fleet:workspaces": "node scripts/test-bot-fleet-workspaces.mjs",
    "bot-fleet:dev": "node scripts/bot-fleet-dev.mjs"
  },
  "devDependencies": {
    "@electron/asar": "4.3.1",
    "@biomejs/biome": "2.5.15",
    "electron": "44.7.0",
    "tar-stream": "3.2.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antonioducs/maestrly-app.git"
  },
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=10"
  },
  "overrides": {
    "@connectrpc/connect-node": {
      "undici": "6.28.1"
    },
    "mermaid": {
      "katex": "^0.18.10"
    },
    "micromark-extension-math": {
      "katex": "^0.18.10"
    }
  }
}
