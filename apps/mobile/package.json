{
  "name": "@maestrly/mobile",
  "version": "0.1.1",
  "description": "Maestrly for iOS and Android: follow and direct your bots",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "node scripts/export.mjs",
    "icons": "node scripts/icons.mjs",
    "test:web": "node scripts/web-e2e.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "eas-build-post-install": "cd ../.. && npm run build:fleet-protocol"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo/metro-runtime": "58.0.15",
    "@maestrly/bot-fleet-protocol": "0.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.19",
    "expo-audio": "~58.0.10",
    "expo-camera": "58.0.12",
    "expo-clipboard": "58.0.4",
    "expo-constants": "58.0.13",
    "expo-crypto": "58.0.7",
    "expo-device": "58.0.5",
    "expo-document-picker": "58.0.4",
    "expo-file-system": "58.0.11",
    "expo-font": "58.0.10",
    "expo-image": "58.0.17",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.14",
    "expo-localization": "58.0.5",
    "expo-notifications": "58.1.6",
    "expo-router": "58.0.26",
    "expo-secure-store": "58.0.2",
    "expo-sharing": "58.0.20",
    "expo-speech-recognition": "58.0.0",
    "expo-splash-screen": "58.0.11",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.6",
    "expo-video": "58.0.12",
    "expo-web-browser": "58.0.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-marked": "8.3.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
