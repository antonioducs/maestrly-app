{
  "name": "@maestrly/mobile",
  "version": "0.1.0",
  "description": "Maestrly for iOS and Android: follow and direct your bots",
  "license": "MIT",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@types/react"
      ]
    }
  },
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "build": "node scripts/export.mjs",
    "icons": "node scripts/icons.mjs",
    "test:web": "node scripts/web-e2e.mjs",
    "screenshots": "node scripts/store-screenshots.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "eas-build-post-install": "cd ../.. && npm run build:fleet-protocol"
  },
  "dependencies": {
    "@expo-google-fonts/bricolage-grotesque": "0.4.1",
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo-google-fonts/jetbrains-mono": "0.4.1",
    "@expo/metro-runtime": "57.0.16",
    "@maestrly/bot-fleet-protocol": "0.1.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.28",
    "expo-camera": "57.0.6",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.21",
    "expo-crypto": "58.0.6",
    "expo-device": "57.0.2",
    "expo-document-picker": "57.0.3",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-image": "57.0.5",
    "expo-image-picker": "57.0.20",
    "expo-linking": "57.0.12",
    "expo-localization": "57.0.2",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.26",
    "expo-secure-store": "57.0.4",
    "expo-sharing": "57.0.23",
    "expo-speech-recognition": "57.1.1",
    "expo-splash-screen": "57.0.10",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-video": "57.0.5",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-marked": "8.3.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.4",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "playwright-core": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
