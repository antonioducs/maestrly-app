 scheduleCheck() {\\n    clearTimeout(checkTimer);\\n    checkTimer = setTimeout(check, 400);\\n  }\\n  function measure() {\\n    var body = document.body;\\n    var height = Math.max(root.getBoundingClientRect().height, body ? body.scrollHeight : 0);\\n    // A horizontal scrollbar takes its height from the frame; asking for it too keeps a vertical one away.\\n    return Math.ceil(height + Math.max(0, window.innerHeight - root.clientHeight));\\n  }\\n  function report(fromResize) {\\n    if (frozen) return;\\n    var height = measure();\\n    root.style.overflowY = height > 2400 ? 'auto' : '';\\n    if (height === last) return;\\n    // The host only applied the height asked for, and the content followed it: it is sized by the frame's own height\\n    // (100vh, height: 100%), so each report would grow it again. Keep the last height instead.\\n    viewportBound = fromResize === true && window.innerWidth === lastWidth && last >= 0 ? viewportBound + 1 : 0;\\n    if (viewportBound >= 3) {\\n      frozen = true;\\n      issue('viewport', '');\\n      return;\\n    }\\n    last = height;\\n    lastWidth = window.innerWidth;\\n    post({ type: 'size', height: height });\\n    scheduleCheck();\\n  }\\n  if (typeof ResizeObserver === 'function') new ResizeObserver(function () { report(false); }).observe(root);\\n  document.addEventListener('DOMContentLoaded', function () { report(false); });\\n  window.addEventListener('load', function () {\\n    loadedPending = true;\\n    report(false);\\n    scheduleCheck();\\n  });\\n  window.addEventListener('resize', function () { report(true); });\\n})();";
  var BASE_CSS = ":root{color-scheme:dark;--ui-text:rgba(237,234,227,.96);--ui-muted:rgba(154,149,140,.85);--ui-card:rgba(255,255,255,.03);--ui-border:rgba(255,255,255,.08);--ui-accent:#edeae3;--ui-accent-text:#0a0a0b;--ui-success:#34d399;--ui-warning:#fbbf24;--ui-danger:#ff7a85;--ui-font:system-ui,-apple-system,\\"Segoe UI\\",Roboto,sans-serif;--ui-mono:ui-monospace,SFMono-Regular,Menlo,monospace;--ui-radius:12px}*,*::before,*::after{box-sizing:border-box}html,body{margin:0;background:transparent}:where(html){overflow-y:hidden}body{padding:2px;color:var(--ui-text);font:14px/1.5 var(--ui-font);overflow-wrap:break-word}:where(h1,h2,h3,h4,h5,h6){margin:0 0 .5em;font-weight:600;line-height:1.25}:where(h1){font-size:1.45em}:where(h2){font-size:1.2em}:where(h3){font-size:1.05em}:where(h4,h5,h6){font-size:1em}:where(p,ul,ol,dl,blockquote,pre,table,figure,.ui-scroll){margin:0 0 .75em}:where(:is(h1,h2,h3,h4,h5,h6,p,ul,ol,dl,blockquote,pre,table,figure,.ui-scroll):last-child){margin-bottom:0}:where(ul,ol){padding-left:1.3em}:where(li+li){margin-top:.25em}:where(a){color:var(--ui-accent);text-underline-offset:2px}:where(strong,b){font-weight:600}:where(small){font-size:12px}:where(code,kbd,samp,pre){font-family:var(--ui-mono);font-size:.9em}:where(:not(pre)>code){padding:.1em .35em;border-radius:5px;background:rgba(255,255,255,.07)}:where(pre){padding:10px 12px;overflow-x:auto;border:1px solid var(--ui-border);border-radius:8px;background:rgba(0,0,0,.25)}:where(hr){height:1px;margin:12px 0;border:0;background:var(--ui-border)}:where(blockquote){margin-left:0;padding-left:12px;border-left:2px solid var(--ui-border);color:var(--ui-muted)}:where(img,video,canvas){max-width:100%;height:auto;vertical-align:middle}:where(svg){max-width:100%;vertical-align:middle}:where(table){width:100%;border-collapse:collapse;font-size:13px}:where(th,td){padding:6px 10px;border-bottom:1px solid var(--ui-border);text-align:left;vertical-align:top}:where(th){color:var(--ui-muted);font-size:12px;fon