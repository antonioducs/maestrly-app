{
  "extends": "./tsconfig.node.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node"],
    "paths": { "@/*": ["./src/renderer/*"] }
  },
  "include": [
    "test/**/*",
    "src/main/**/*",
    "src/preload/**/*",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
