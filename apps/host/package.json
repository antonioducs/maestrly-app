{
  "name": "@maestrly/host",
  "version": "0.2.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.15.0 <23"
  },
  "bin": {
    "maestrly-host": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run test/*.test.ts && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "test:lab": "vitest run test/lab/host-lifecycle.test.ts"
  },
  "dependencies": {
    "@maestrly/host-core": "0.2.0",
    "@maestrly/host-protocol": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
