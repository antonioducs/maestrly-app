{
  "name": "@maestrly/bot-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Local Maestrly VM host console",
  "author": "Maestrly contributors",
  "license": "MIT",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "package:lab": "node ../../scripts/package-bot-lab.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@maestrly/host-protocol": "0.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "42.11.2",
    "electron-builder": "^26.8.1",
    "electron-vite": "5.0.0",
    "typescript": "5.9.3",
    "vite": "^7.0.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.15.0 <23"
  }
}
